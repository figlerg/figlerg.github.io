@comment{
  ============================================================================
  HINWEIS (Felix): Hier kommen deine BibTeX-Eintraege rein. Die Publikationsliste
  unter /publications/ wird daraus automatisch generiert.

  WICHTIG: BibTeX kennt KEINE Zeilen-Kommentare (kein % und kein //). Felder, die
  du (noch) nicht willst, einfach ganz WEGLASSEN statt auskommentieren.

  Du kannst normale BibTeX-Eintraege einfuegen (z.B. den "Cite"-Export von
  Google Scholar / dem Verlag). al-folio versteht zusaetzlich diese optionalen
  Sonderfelder, die schoene Buttons/Badges erzeugen:

    selected    = {true}        -> erscheint auch auf der Startseite ("selected papers")
    bibtex_show = {true}        -> Button, der den BibTeX-Eintrag anzeigt
    abbr        = {FM'25}       -> kleines Kuerzel/Badge links neben dem Eintrag
    pdf         = {datei.pdf}   -> "PDF"-Button (lokale PDFs in assets/pdf/ ablegen; auch volle URL moeglich)
    code        = {https://github.com/...}   -> "Code"-Button
    html        = {https://...}              -> "HTML"/Verlags-Button
    arxiv       = {2401.00000}               -> arXiv-Button
    doi         = {10.1145/...}
    abstract    = {...}         -> ausklappbares Abstract
    preview     = {bild.png}    -> Vorschaubild (in assets/img/publication_preview/)

  Loesche diesen Block gern, sobald du eigene Eintraege hast.
  ============================================================================
}

@inproceedings{gigler2025example,
  abbr        = {VENUE'25},
  title       = {Titel deiner Publikation},
  author      = {Gigler, Felix and Coauthor, A.},
  booktitle   = {Proceedings of the Some Conference (VENUE)},
  year        = {2025},
  bibtex_show = {true},
  selected    = {true}
}
